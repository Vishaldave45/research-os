# ==========================================
# ResearchOS Environment Configuration
# ==========================================

# Database
POSTGRES_USER=researchos
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=researchos_db
DATABASE_URL=postgresql+asyncpg://researchos:CHANGE_ME_IN_PRODUCTION@localhost:5432/researchos_db

# JWT Authentication & Cryptography
JWT_SECRET_KEY=CHANGE_ME_SECURE_RANDOM_KEY_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend Proxy Target
VITE_BACKEND_URL=http://localhost:8000
